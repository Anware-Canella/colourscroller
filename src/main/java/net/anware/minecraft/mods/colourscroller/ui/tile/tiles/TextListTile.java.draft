package net.anware.minecraft.mods.colourscroller.ui.tile.tiles;

import net.anware.minecraft.mods.colourscroller.keybind.KeyWrapper;
import net.anware.minecraft.mods.colourscroller.ui.screen.TileScreen;
import net.anware.minecraft.mods.colourscroller.ui.tile.ATile;
import net.minecraft.client.util.math.MatrixStack;
import net.minecraft.text.LiteralText;
import net.minecraft.text.OrderedText;
import net.minecraft.text.Text;
import org.lwjgl.glfw.GLFW;

import java.util.ArrayList;

public class TextListTile extends ComTile {
    public TextListTile(TileScreen screen, int x, int paddingTop, int paddingBottom, int width, ArrayList<StringBuilder> text, int lineHeight) {
        super(screen, x, paddingTop, paddingBottom);
        this.text = text;
        this.width = width;
        this.lineHeight = lineHeight;
    }

    protected final ArrayList<StringBuilder> text;
    protected int activeLine = -1;
    protected final int width;
    protected final int lineHeight;
    public static final int MARGIN = 8, BUTTON_SIZE = 10;
    public static final Text MINUS_TEXT = new LiteralText("-"), PLUS_TEXT = new LiteralText("+");

    @Override
    public int getContentWidth() {
        return this.width;
    }

    @Override
    public void render(MatrixStack matrices, int mouseX, int mouseY, float delta) {
        // get hovered button
        int button = getButtonAt(mouseX, mouseY);
        boolean text = true;
        if (button != -1) {
            text = (button & 0x1) == 0;
            button >>= 1;
        }
        // render outer box
        this.hover = this.getHover(mouseX, mouseY);
        drawBox(matrices, null, null, this.x, this.x + this.getContentWidth(), this.y, this.y + this.getContentHeight(), this.getState());
        // render text
        float offset = this.y + (float) this.lineHeight / 2;
        for (int i = 0; i < this.text.size(); i++) {
            this.drawText(matrices, this.getScreen().getTextRenderer(), new LiteralText(this.text.get(i).toString()),
                    this.x + MARGIN,
                    offset + this.lineHeight * i,
                    i == this.activeLine ? 0xFF00FFFF : 0xFFFFFFFF,
                    ALIGN_LEFT
            );
        }
        // render the cursor
        if (this.activeLine != -1) {
            OrderedText ot = new LiteralText(this.text.get(this.activeLine).toString()).asOrderedText();
            int dx = this.x + MARGIN + this.screen.getTextRenderer().getWidth(ot);
            drawHoriLine(matrices, dx, dx + 5, this.y + this.lineHeight / 2 + 4 + this.activeLine * this.lineHeight, 0xFFAA00FF);
        }
        // render remove buttons
        int x2 = this.x + this.getContentWidth() - MARGIN;
        int x1 = x2 - BUTTON_SIZE;
        int y = this.y + this.lineHeight / 2 - BUTTON_SIZE / 2;
        for (int i = 0; i < this.text.size(); i++) {
            int y1 = y + i * this.lineHeight;
            this.drawBox(matrices, this.getScreen().getTextRenderer(), MINUS_TEXT, x1, x2, y1, y1 + BUTTON_SIZE, (!text && (button == i)) ? STATE_HOVER : STATE_IDLE);
        }
        y += this.text.size() * this.lineHeight;
        this.drawBox(matrices, this.getScreen().getTextRenderer(), PLUS_TEXT, x1, x2, y, y + BUTTON_SIZE, (!text && (button == this.text.size())) ? STATE_HOVER : STATE_IDLE);
    }

    @Override
    public boolean mouseClicked(double mouseX, double mouseY, int button) {
        boolean clicked = this.setClickActive();
        if (!this.hover) {
            return clicked;
        }
        int bt = this.getButtonAt((int) mouseX, (int) mouseY);
        if (bt == -1) {
            return false;
        }
        boolean clickedOnText = (bt & 1) == 0;
        bt >>= 1;
        if (clickedOnText) {
            this.activeLine = bt;
        } else {
            this.activeLine = -1;
            if (bt == this.text.size()) {
                this.text.add(new StringBuilder("minecraft:"));
                this.activeLine = this.text.size() - 1;
            } else {
                this.text.remove(bt);
            }
            this.screen.reloadChildren();
        }
        return clicked;
    }

    @Override
    public boolean keyPressed(int keyCode, int scanCode, int modifiers) {
        if (keyCode == GLFW.GLFW_KEY_BACKSPACE && this.activeLine != -1) {
            StringBuilder str = this.text.get(this.activeLine);
            if (str != null) {
                if (GLFW.glfwGetKey(KeyWrapper.INSTANCE.window, GLFW.GLFW_KEY_LEFT_CONTROL) == GLFW.GLFW_PRESS) {
                    this.text.set(this.activeLine, new StringBuilder());
                    return true;
                } else if (!str.isEmpty()) {
                    str.deleteCharAt(str.length() - 1);
                    return true;
                }
            }
        }
        if (keyCode == GLFW.GLFW_KEY_ENTER) {
            this.activeLine = -1;
            return true;
        }
        return false;
    }

    @Override
    public boolean charTyped(char chr, int modifiers) {
        if (this.activeLine >= 0 && this.activeLine < this.text.size()) {
            StringBuilder str = this.text.get(this.activeLine);
            if (str != null) {
                str.append(chr);
                return true;
            }
        }
        return false;
    }

    protected int getButtonAt(int x, int y) {
        x -= this.x;
        y -= this.y;
        if (x < MARGIN || x > this.width - MARGIN) {
            return -1;
        }
        if (x < this.width - MARGIN - BUTTON_SIZE) {
            // clicked on a line of text
            int line = getButtonIndex(y, 0, this.lineHeight, this.lineHeight, this.text.size());
            if (line == -1) return -1;
            return line << 1;
        }
        else {
            // clicked on a button
            int line = getButtonIndex(y, 0, this.lineHeight, BUTTON_SIZE, this.text.size() + 1);
            if (line == -1) return -1;
            return (line << 1) | 1;
        }
    }

    public static int getButtonIndex(int y, int margin, int lineHeight, int buttonSize, int buttonCount) {
        double relativeY = y - margin - lineHeight / 2.0;
        int index = (int) Math.round(relativeY / lineHeight);
        if (index < 0 || index >= buttonCount) {
            return -1;
        }
        double centerY = margin + (index + 0.5) * lineHeight;
        if (y >= centerY - buttonSize / 2.0 && y <= centerY + buttonSize / 2.0) {
            return index;
        }
        return -1;
    }

    @Override
    public void setActive(boolean active) {
        super.setActive(active);
        if (!active) {
            this.activeLine = -1;
        }
    }

    @Override
    public int getContentHeight() {
        return this.lineHeight * (this.text.size() + 1);
    }
}
