package net.anware.minecraft.mods.colourscroller.ui.tile.tiles;

import net.anware.minecraft.mods.colourscroller.scroll.ScrollList;
import net.anware.minecraft.mods.colourscroller.ui.screen.TileScreen;
import net.anware.minecraft.mods.colourscroller.ui.tile.ATile;
import net.anware.minecraft.mods.colourscroller.ui.tile.Tile;
import net.minecraft.client.util.math.MatrixStack;

public class ItemListTile extends ComTile {
    public ItemListTile(TileScreen screen, int x, int paddingTop, int paddingBottom, ScrollList scroll, int scale, int cols) {
        super(screen, x, paddingTop, paddingBottom);
        this.scroll = scroll;
        this.scale = scale;
        this.cols = cols;

        this.FRAME_SIZE = FRAME_GAP * 2 + ITEM_SIZE * scale;
        this.TILE_SIZE = TILE_GAP * 2 + FRAME_SIZE;
    }

    protected final ScrollList scroll;
    protected final int scale;
    protected final int cols;

    protected final int TILE_GAP = 2;
    protected final int FRAME_GAP = 2;
    protected final int FRAME_SIZE;
    protected final int TILE_SIZE;

    @Override
    public int getContentWidth() {
        return TILE_SIZE * this.cols + TILE_GAP * 2;
    }

    @Override
    public int getContentHeight() {
        int lines = Tile.ceil(this.scroll.size(), this.cols);
        return lines * TILE_SIZE + TILE_GAP * 2;
    }

    @Override
    public void render(MatrixStack matrices, int mouseX, int mouseY, float delta) {
        this.hover = this.getHover(mouseX, mouseY);
        this.drawBox(matrices, null, null, this.x, this.x + this.getContentWidth(), this.y, this.y + this.getContentHeight(), this.getState());
        for (int i = 0; i < this.scroll.size(); i++) {
            int x = this.x + (i % this.cols) * TILE_SIZE + TILE_GAP + TILE_GAP;
            int y = this.y + (i / this.cols) * TILE_SIZE + TILE_GAP + TILE_GAP;
            drawBox(matrices, x, x + FRAME_SIZE, y, y + FRAME_SIZE, 0xFFA0A0A0);
            drawItem(this.scroll.getStack(i), x + FRAME_GAP, y + FRAME_GAP, this.scale);
        }
    }

    @Override
    public boolean mouseClicked(double mouseX, double mouseY, int button) {
        boolean clicked = this.setClickActive();
        return clicked;
    }

    @Override
    public boolean mouseDragged(double mouseX, double mouseY, int button, double deltaX, double deltaY) {
        return false;
    }

    @Override
    public boolean charTyped(char chr, int modifiers) {
        return false;
    }
}